# Server
PORT=3001

# Where the SQLite database file is stored
DATABASE_PATH=./data/portfolio.db

# Optional: path to a JSON file of { "market_hash_name": price } you maintain
# by hand (e.g. pasted from the CS2Trader extension's valuation view). When the
# file exists, prices found in it win over live lookups. See
# data/price-overrides.example.json for the format. Leave the default if you
# don't want to use this.
PRICE_OVERRIDES_PATH=./data/price-overrides.json

# Your Steam profile (used to optionally auto-sync your inventory)
# SteamID64, e.g. 76561198000000000
STEAM_ID=
# Steam Web API key (https://steamcommunity.com/dev/apikey) - only needed for inventory auto-sync
STEAM_API_KEY=

# Claude / Anthropic - powers the natural language chat agent (add/edit/delete trades by talking to it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: CSFloat API key for higher float-lookup rate limits (https://csfloat.com/api)
# Leave empty to use the free, unauthenticated lookup endpoint (lower rate limit)
CSFLOAT_API_KEY=

# How often to refresh prices for every item you hold, in cron syntax (default: every 15 minutes)
PRICE_SYNC_CRON=*/15 * * * *

# Manipulation alerts: trigger when an item's price moves more than this % within ALERT_WINDOW_HOURS
ALERT_THRESHOLD_PERCENT=15
ALERT_WINDOW_HOURS=24

# Discord webhook URL to receive price-spike alerts (optional but recommended)
DISCORD_WEBHOOK_URL=

# Currency for Steam Market price lookups (1 = USD). See providers/price/SteamMarketPriceProvider.js
STEAM_CURRENCY=1
