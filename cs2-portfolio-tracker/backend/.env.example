# ============================================================
# ESENCIALES - edita estas para que la app arranque con tus datos
# (el script ./setup.sh, en la raíz del proyecto, te las pide por ti)
# ============================================================

# Tu perfil de Steam (SteamID64, ej. 76561198000000000) - se usa para
# sincronizar tu inventario y floats. Búscalo en https://steamid.io pegando
# el link de tu perfil. Recuerda dejar tu inventario público
# (Steam > Editar perfil > Privacidad > Detalles del inventario).
STEAM_ID=

# Clave de la API de Anthropic (https://console.anthropic.com, sección API
# Keys) - habilita el chat con Claude para registrar/editar/eliminar trades
# por lenguaje natural. Sin ella, el resto de la app funciona normalmente
# pero la pestaña de chat aparece deshabilitada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# OPCIONALES RECOMENDADOS
# ============================================================

# Webhook de Discord a donde mandar las alertas de movimientos de precio
DISCORD_WEBHOOK_URL=

# Steam Web API key (https://steamcommunity.com/dev/apikey) - opcional,
# solo si quieres afinar la sincronización automática de inventario
STEAM_API_KEY=

# Clave de CSFloat (https://csfloat.com/api) - opcional, da mayor límite de
# tasa para consultas de float. Sin ella se usa el endpoint público (más lento)
CSFLOAT_API_KEY=

# ============================================================
# AVANZADO - rara vez hace falta tocar esto
# ============================================================

# Servidor y base de datos
PORT=3001
DATABASE_PATH=./data/portfolio.db

# Ruta a tu JSON de precios manuales (ver data/price-overrides.example.json),
# útil si copias valores de la extensión CS2Trader. Cuando el archivo existe,
# esos precios ganan siempre sobre los de Steam Market.
PRICE_OVERRIDES_PATH=./data/price-overrides.json

# Frecuencia de sincronización de precios, en sintaxis cron (por defecto cada 15 min)
PRICE_SYNC_CRON=*/15 * * * *

# Cuándo se considera un "movimiento sospechoso": % de cambio dentro de la
# ventana de horas indicada (por defecto ±15% en 24h)
ALERT_THRESHOLD_PERCENT=15
ALERT_WINDOW_HOURS=24

# Moneda para precios de Steam Market (1 = USD)
STEAM_CURRENCY=1
